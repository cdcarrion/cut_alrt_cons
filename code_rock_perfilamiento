    def asignar_perfil_generico(
        df,
        col_tipo_modelo,
        col_score,
        col_saldo,
        col_perfiles,
        reglas_ce,
        reglas_se
    ):
        """
        Version generica de asignar_perfil: en vez de tener los cortes
        escritos adentro del F.when(), los recibe como parametro (reglas_ce /
        reglas_se), asi UNA sola funcion sirve para saldoCuentas, U3M o U6M
        -- solo cambia la tabla de reglas que le pasas.

        Cada regla es una tupla:
            (score_min, score_max, saldo_min, saldo_max, incluye_missing, etiqueta)
        None = sin limite en ese lado. incluye_missing=True agrega
        "o el saldo es nulo" a esa regla.

        Por defecto cada limite es score/saldo >= min y < max (igual que en
        los arboles). Si necesitas el operador exacto contrario (> en vez de
        >=, o <= en vez de <, como pasaba en 2 reglas del saldoCuentas
        original), pasa ese limite como tupla (valor, inclusive):
            (552, False)  ->  saldo > 552   (estricto, no incluye el 552)
            (7.26, True)  ->  saldo <= 7.26 (incluye el 7.26)
        """

        def limite(campo, valor, es_max, incl_por_defecto):
            if valor is None:
                return F.lit(True)
            if isinstance(valor, tuple):
                v, incl = valor
            else:
                v, incl = valor, incl_por_defecto
            if es_max:
                return (F.col(campo) <= v) if incl else (F.col(campo) < v)
            else:
                return (F.col(campo) >= v) if incl else (F.col(campo) > v)

        def construir_condicion(regla):
            score_min, score_max, saldo_min, saldo_max, incluye_missing, etiqueta = regla

            cond = limite(col_score, score_min, es_max=False, incl_por_defecto=True)
            cond = cond & limite(col_score, score_max, es_max=True, incl_por_defecto=False)

            cond_saldo = limite(col_saldo, saldo_min, es_max=False, incl_por_defecto=True)
            cond_saldo = cond_saldo & limite(col_saldo, saldo_max, es_max=True, incl_por_defecto=False)
            if incluye_missing:
                cond_saldo = cond_saldo | F.col(col_saldo).isNull()

            return cond & cond_saldo, etiqueta

        def construir_chain(reglas):
            chain = None
            for regla in reglas:
                cond, etiqueta = construir_condicion(regla)
                chain = F.when(cond, etiqueta) if chain is None else chain.when(cond, etiqueta)
            return chain.otherwise("Sin Perfil")

        tipo_ce = F.col(col_tipo_modelo).endswith("CE")

        perfiles_expr = F.when(
            tipo_ce, construir_chain(reglas_ce)
        ).otherwise(
            construir_chain(reglas_se)
        )

        return df.withColumn(col_perfiles, perfiles_expr)

